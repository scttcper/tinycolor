{
  "name": "@ctrl/tinycolor",
  "version": "0.0.0",
  "description": "Fast, small color manipulation and conversion for JavaScript",
  "author": "Scott Cooper <scttcper@gmail.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "homepage": "https://tinycolor.vercel.app",
  "repository": "scttcper/tinycolor",
  "keywords": [
    "typescript",
    "color",
    "manipulation",
    "tinycolor",
    "hsa",
    "rgb"
  ],
  "main": "dist/public_api.js",
  "module": "dist/module/public_api.js",
  "typings": "dist/public_api.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "demo:build": "cd demo && node --run build",
    "demo:watch": "cd demo && node --run dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "node --run build",
    "build": "del-cli dist && tsc -p tsconfig.build.json && tsc -p tsconfig.module.json && node build.ts",
    "docs:build": "typedoc --out demo/dist/docs --hideGenerator --tsconfig tsconfig.build.json src/public_api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=./junit.xml",
    "bench": "vitest bench --config vitest.bench.config.mts --run --reporter=verbose",
    "bench:watch": "vitest bench --config vitest.bench.config.mts --watch --reporter=verbose"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-terser": "1.0.2",
    "@types/node": "24.19.2",
    "del-cli": "8.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "rollup": "4.65.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "pnpm@12.15.0"
}
